  <!-- =========================================
       TOAST
  ========================================= -->

  <div
    class="toast"
    id="toast">
  </div>


  <!-- =========================================
       JAVASCRIPT
  ========================================= -->

  <script>

    /* =========================================
       OPPORTUNITY DATA
    ========================================= */

    const opportunities = [

      {
        id: 1,
        title: "Global Student Scholarship",
        category: "Scholarship",
        organization: "Education Foundation",
        location: "Online",
        deadline: "30 November 2026",
        description:
          "Financial support for students pursuing higher education."
      },

      {
        id: 2,
        title: "Software Development Internship",
        category: "Internship",
        organization: "Tech Solutions",
        location: "Kigali",
        deadline: "15 December 2026",
        description:
          "Gain practical experience in web and software development."
      },

      {
        id: 3,
        title: "Free Web Development Course",
        category: "Course",
        organization: "Learning Academy",
        location: "Online",
        deadline: "Open",
        description:
          "Learn HTML, CSS and JavaScript from beginner to advanced level."
      },

      {
        id: 4,
        title: "Junior Web Developer",
        category: "Job",
        organization: "Digital Agency",
        location: "Kigali",
        deadline: "20 December 2026",
        description:
          "Entry-level opportunity for students interested in web development."
      },

      {
        id: 5,
        title: "STEM Excellence Scholarship",
        category: "Scholarship",
        organization: "Future Scientists",
        location: "Africa",
        deadline: "10 January 2027",
        description:
          "Scholarship opportunity for students studying science and technology."
      },

      {
        id: 6,
        title: "Digital Marketing Internship",
        category: "Internship",
        organization: "Creative Media",
        location: "Hybrid",
        deadline: "5 December 2026",
        description:
          "Develop professional skills in digital marketing and social media."
      },

      {
        id: 7,
        title: "Python Programming Course",
        category: "Course",
        organization: "Code Academy",
        location: "Online",
        deadline: "Open",
        description:
          "Learn Python programming through practical projects."
      },

      {
        id: 8,
        title: "Graphic Design Internship",
        category: "Internship",
        organization: "Creative Studio",
        location: "Kigali",
        deadline: "18 December 2026",
        description:
          "Build a professional design portfolio while working with a creative team."
      },

      {
        id: 9,
        title: "Data Analyst Graduate Program",
        category: "Job",
        organization: "Data Africa",
        location: "Remote",
        deadline: "28 December 2026",
        description:
          "Entry-level data analytics opportunity for motivated graduates."
      },

      {
        id: 10,
        title: "Cybersecurity Fundamentals",
        category: "Course",
        organization: "Open Learning",
        location: "Online",
        deadline: "Open",
        description:
          "Introduction to cybersecurity concepts and digital safety."
      },

      {
        id: 11,
        title: "Women in Technology Scholarship",
        category: "Scholarship",
        organization: "Tech Future",
        location: "Africa",
        deadline: "12 January 2027",
        description:
          "Educational funding and mentorship for women pursuing technology."
      },

      {
        id: 12,
        title: "Business Administration Internship",
        category: "Internship",
        organization: "Business Group",
        location: "Kigali",
        deadline: "22 December 2026",
        description:
          "Practical experience in administration, business and project management."
      }

    ];


    /* =========================================
       LOCAL STORAGE
    ========================================= */

    let saved =
      JSON.parse(
        localStorage.getItem("savedOpportunities")
      ) || [];


    let viewed =
      Number(
        localStorage.getItem("viewedOpportunities")
      ) || 0;


    /* =========================================
       DISPLAY OPPORTUNITIES
    ========================================= */

    function displayOpportunities(data) {

      const container =
        document.getElementById(
          "opportunityList"
        );

      container.innerHTML = "";


      if (data.length === 0) {

        container.innerHTML = `

          <div style="
            grid-column:1/-1;
            text-align:center;
            padding:50px;
            color:var(--muted);
          ">

            <h3>
              No opportunities found.
            </h3>

            <p>
              Try another search or category.
            </p>

          </div>

        `;

        return;
      }


      data.forEach(item => {

        const isSaved =
          saved.includes(item.id);


        const card =
          document.createElement("div");


        card.className =
          "opportunity";


        card.innerHTML = `

          <span class="tag">
            ${item.category}
          </span>

          <h3>
            ${item.title}
          </h3>

          <p>
            ${item.description}
          </p>

          <div class="details">

            <span>
              🏢 ${item.organization}
            </span>

            <span>
              📍 ${item.location}
            </span>

            <span>
              📅 Deadline: ${item.deadline}
            </span>

          </div>

          <div class="card-buttons">

            <button
              class="apply-btn"
              onclick="viewOpportunity(${item.id})">

              View Details

            </button>

            <button
              class="save-btn ${isSaved ? "saved" : ""}"
              onclick="saveOpportunity(${item.id})">

              ${isSaved ? "★" : "☆"}

            </button>

          </div>

        `;


        container.appendChild(card);

      });

    }


    /* =========================================
       SEARCH AND FILTER
    ========================================= */

    function filterOpportunities() {

      const search =
        document
          .getElementById("searchInput")
          .value
          .toLowerCase()
          .trim();


      const category =
        document
          .getElementById("categoryFilter")
          .value;


      const filtered =
        opportunities.filter(item => {

          const matchesSearch =
            item.title
              .toLowerCase()
              .includes(search) ||

            item.description
              .toLowerCase()
              .includes(search) ||

            item.organization
              .toLowerCase()
              .includes(search) ||

            item.location
              .toLowerCase()
              .includes(search);


          const matchesCategory =
            category === "All" ||
            item.category === category;


          return (
            matchesSearch &&
            matchesCategory
          );

        });


      displayOpportunities(filtered);

    }


    /* =========================================
       CATEGORY FILTER
    ========================================= */

    function filterCategory(category) {

      document
        .getElementById("categoryFilter")
        .value = category;


      scrollToSection("opportunities");


      filterOpportunities();

    }


    /* =========================================
       SAVE OPPORTUNITY
    ========================================= */

    function saveOpportunity(id) {

      if (saved.includes(id)) {

        saved =
          saved.filter(
            item => item !== id
          );

        showToast(
          "Removed from saved opportunities."
        );

      } else {

        saved.push(id);

        showToast(
          "Opportunity saved ⭐"
        );

      }


      localStorage.setItem(
        "savedOpportunities",
        JSON.stringify(saved)
      );


      updateDashboard();

      filterOpportunities();

    }


    /* =========================================
       VIEW OPPORTUNITY
    ========================================= */

    function viewOpportunity(id) {

      const item =
        opportunities.find(
          opportunity =>
            opportunity.id === id
        );


      viewed++;


      localStorage.setItem(
        "viewedOpportunities",
        viewed
      );


      updateDashboard();


      alert(

        `${item.title}\n\n` +

        `Organization: ${item.organization}\n` +

        `Location: ${item.location}\n` +

        `Deadline: ${item.deadline}\n\n` +

        `${item.description}\n\n` +

        `This is a demonstration opportunity.`

      );

    }


    /* =========================================
       ELIGIBILITY CHECKER
    ========================================= */

    function checkEligibility() {

      const age =
        Number(
          document.getElementById("age").value
        );


      const education =
        document.getElementById("education").value;


      const type =
        document.getElementById("opportunityType").value;


      const result =
        document.getElementById("result");


      if (
        !age ||
        !education ||
        !type
      ) {

        result.style.display = "block";

        result.className = "warning";

        result.innerHTML =
          "⚠️ Please complete all fields.";

        return;

      }


      let eligible = true;

      let message = "";


      if (
        type === "job" &&
        age < 18
      ) {

        eligible = false;

        message =
          "Many job opportunities require applicants to be 18 or older.";

      }


      else if (
        type === "internship" &&
        age < 16
      ) {

        eligible = false;

        message =
          "Many internship programs require applicants to be at least 16.";

      }


      else if (
        type === "scholarship" &&
        education === "secondary" &&
        age > 30
      ) {

        eligible = false;

        message =
          "This demonstration checker expects a typical student age range.";

      }


      else {

        message =
          "Based on the information provided, you may meet the basic criteria. Always check the individual opportunity requirements before applying.";

      }


      result.style.display = "block";


      if (eligible) {

        result.className =
          "success";

        result.innerHTML =
          "✅ " + message;

      } else {

        result.className =
          "warning";

        result.innerHTML =
          "⚠️ " + message;

      }

    }


    /* =========================================
       DARK MODE
    ========================================= */

    function toggleTheme() {

      document.body.classList.toggle(
        "dark"
      );


      const dark =
        document.body.classList.contains(
          "dark"
        );


      localStorage.setItem(
        "darkMode",
        dark
      );


      document.getElementById(
        "themeButton"
      ).textContent =
        dark ? "☀️" : "🌙";

    }


    /* =========================================
       MOBILE MENU
    ========================================= */

    function toggleMenu() {

      document
        .getElementById("navLinks")
        .classList.toggle("active");

    }


    /* =========================================
       SMOOTH SCROLL
    ========================================= */

    function scrollToSection(id) {

      const section =
        document.getElementById(id);


      if (section) {

        section.scrollIntoView({
          behavior: "smooth"
        });

      }

    }


    /* =========================================
       DASHBOARD
    ========================================= */

    function updateDashboard() {

      document.getElementById(
        "savedCount"
      ).textContent =
        saved.length;


      document.getElementById(
        "viewCount"
      ).textContent =
        viewed;

    }


    /* =========================================
       TOAST
    ========================================= */

    function showToast(message) {

      const toast =
        document.getElementById("toast");


      toast.textContent =
        message;


      toast.classList.add(
        "show"
      );


      setTimeout(() => {

        toast.classList.remove(
          "show"
        );

      }, 2500);

    }


    /* =========================================
       UPDATE HERO STATISTICS
    ========================================= */

    function updateHeroStats() {

      const total =
        opportunities.length;


      const scholarships =
        opportunities.filter(
          item =>
            item.category === "Scholarship"
        ).length;


      const internships =
        opportunities.filter(
          item =>
            item.category === "Internship"
        ).length;


      const courses =
        opportunities.filter(
          item =>
            item.category === "Course"
        ).length;


      const jobs =
        opportunities.filter(
          item =>
            item.category === "Job"
        ).length;


      document.getElementById(
        "heroTotal"
      ).textContent =
        total;


      document.getElementById(
        "heroScholarships"
      ).textContent =
        scholarships;


      document.getElementById(
        "heroInternships"
      ).textContent =
        internships;


      document.getElementById(
        "heroCourses"
      ).textContent =
        courses;


      document.getElementById(
        "heroJobs"
      ).textContent =
        jobs;

    }


    /* =========================================
       CLOSE MOBILE MENU WHEN LINK CLICKED
    ========================================= */

    document
      .querySelectorAll(".nav-links a")
      .forEach(link => {

        link.addEventListener(
          "click",
          () => {

            document
              .getElementById("navLinks")
              .classList.remove("active");

          }
        );

      });


    /* =========================================
       INITIALIZATION
    ========================================= */

    if (
      localStorage.getItem("darkMode") === "true"
    ) {

      document.body.classList.add(
        "dark"
      );


      document.getElementById(
        "themeButton"
      ).textContent =
        "☀️";

    }


    displayOpportunities(
      opportunities
    );


    updateDashboard();


    updateHeroStats();

  </script>

</body>
</html>
