<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta
    name="description"
    content="OpportunityHub helps students discover scholarships, internships, jobs and free learning opportunities."
  >

  <title>Bizi HUB</title>

  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='white'/%3E%3Cpath d='M50 18 C40 11 27 15 23 26 C12 29 7 42 13 52 C8 63 15 76 27 79 C33 90 47 93 57 86 C68 90 80 82 81 70 C91 63 91 48 82 40 C82 28 70 20 59 23 C56 16 53 15 50 18Z' fill='none' stroke='%2310a37f' stroke-width='7' stroke-linecap='round' stroke-linejoin='round'/%3E%3Cpath d='M50 18 L50 50 L57 86 M23 26 L50 50 L82 40 M13 52 L50 50 L81 70 M27 79 L50 50' fill='none' stroke='%2310a37f' stroke-width='7' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">

  <style>
    /* =========================================
       GLOBAL STYLES
    ========================================= */

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, Helvetica, sans-serif;
    }

    html {
      scroll-behavior: smooth;
    }

    :root {
      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --secondary: #7c3aed;
      --bg: #f5f7fb;
      --card: #ffffff;
      --text: #172033;
      --muted: #667085;
      --border: #e5e7eb;
      --success: #16a34a;
      --warning: #d97706;
      --danger: #dc2626;
      --shadow: 0 15px 35px rgba(0, 0, 0, 0.07);
    }

    body.dark {
      --bg: #0f172a;
      --card: #1e293b;
      --text: #f8fafc;
      --muted: #94a3b8;
      --border: #334155;
      --shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
    }

    body {
      background: var(--bg);
      color: var(--text);
      transition: 0.3s;
      line-height: 1.5;
    }

    button {
      cursor: pointer;
      border: none;
    }

    a {
      color: inherit;
    }

    /* =========================================
       NAVBAR
    ========================================= */

    nav {
      height: 72px;
      background: var(--card);
      border-bottom: 1px solid var(--border);

      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 0 6%;

      position: sticky;
      top: 0;
      z-index: 1000;
    }


    .brand-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: inherit;
    }

    .brand-icon {
      width: 38px;
      height: 38px;
      flex-shrink: 0;
    }

    .brand-icon .logo-line {
      fill: none;
      stroke: currentColor;
      stroke-width: 7;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .logo {
      font-size: 25px;
      font-weight: 800;
      color: var(--primary);
    }

    .logo span {
      color: var(--secondary);
    }

    .nav-links {
      list-style: none;
      display: flex;
      gap: 25px;
    }

    .nav-links a {
      text-decoration: none;
      color: var(--text);
      font-weight: 600;
      transition: 0.3s;
    }

    .nav-links a:hover {
      color: var(--primary);
    }

    .nav-actions {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .theme-btn {
      background: var(--bg);
      color: var(--text);
      padding: 10px 14px;
      border-radius: 10px;
      font-size: 18px;
    }

    /* Mobile menu button */

    .menu-btn {
      display: none;
      background: var(--bg);
      color: var(--text);
      font-size: 22px;
      padding: 8px 12px;
      border-radius: 8px;
    }

    /* =========================================
       HERO
    ========================================= */

    .hero {
      min-height: 520px;

      padding: 80px 7%;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 50px;

      background:
        linear-gradient(
          135deg,
          rgba(37, 99, 235, 0.96),
          rgba(124, 58, 237, 0.95)
        );

      color: white;
    }

    .hero-content {
      max-width: 680px;
    }

    .hero h1 {
      font-size: 55px;
      line-height: 1.08;
      margin-bottom: 22px;
    }

    .hero p {
      font-size: 18px;
      line-height: 1.8;
      margin-bottom: 30px;
      opacity: 0.92;
    }

    .hero-buttons {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
    }

    .primary-btn {
      background: white;
      color: var(--primary);
      padding: 14px 22px;
      border-radius: 10px;
      font-weight: bold;
      transition: 0.3s;
    }

    .primary-btn:hover {
      transform: translateY(-2px);
    }

    .secondary-btn {
      background: rgba(255, 255, 255, 0.15);
      color: white;
      padding: 14px 22px;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.3);
      font-weight: bold;
    }

    .hero-card {
      width: 320px;

      background: rgba(255, 255, 255, 0.13);

      padding: 30px;

      border-radius: 20px;

      backdrop-filter: blur(12px);

      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .hero-card h3 {
      margin-bottom: 20px;
      font-size: 20px;
    }

    .stat {
      display: flex;
      justify-content: space-between;

      padding: 13px 0;

      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }

    /* =========================================
       SECTIONS
    ========================================= */

    section {
      padding: 75px 7%;
    }

    .section-title {
      text-align: center;
      margin-bottom: 42px;
    }

    .section-title h2 {
      font-size: 35px;
      margin-bottom: 10px;
    }

    .section-title p {
      color: var(--muted);
    }

    /* =========================================
       CATEGORIES
    ========================================= */

    .categories {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .category {
      background: var(--card);
      border: 1px solid var(--border);

      padding: 30px 20px;

      border-radius: 16px;

      text-align: center;

      cursor: pointer;

      transition: 0.3s;
    }

    .category:hover {
      transform: translateY(-6px);
      border-color: var(--primary);
      box-shadow: var(--shadow);
    }

    .category-icon {
      font-size: 42px;
      margin-bottom: 15px;
    }

    .category h3 {
      margin-bottom: 8px;
    }

    .category p {
      color: var(--muted);
    }

    /* =========================================
       SEARCH
    ========================================= */

    .search-box {
      max-width: 900px;

      margin: 0 auto 40px;

      display: flex;

      gap: 10px;
    }

    .search-box input,
    .search-box select {
      padding: 15px;

      border: 1px solid var(--border);

      border-radius: 10px;

      background: var(--card);

      color: var(--text);

      outline: none;
    }

    .search-box input {
      flex: 1;
    }

    .search-box select {
      width: 190px;
    }

    .search-box input:focus,
    .search-box select:focus {
      border-color: var(--primary);
    }

    /* =========================================
       OPPORTUNITIES
    ========================================= */

    .opportunities {
      display: grid;

      grid-template-columns: repeat(3, 1fr);

      gap: 22px;
    }

    .opportunity {
      background: var(--card);

      border: 1px solid var(--border);

      border-radius: 17px;

      padding: 25px;

      transition: 0.3s;
    }

    .opportunity:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow);
    }

    .tag {
      display: inline-block;

      background: #dbeafe;

      color: #1d4ed8;

      padding: 6px 11px;

      border-radius: 20px;

      font-size: 12px;

      font-weight: bold;

      margin-bottom: 15px;
    }

    body.dark .tag {
      background: #1e3a8a;
      color: #bfdbfe;
    }

    .opportunity h3 {
      margin-bottom: 10px;
      font-size: 20px;
    }

    .opportunity p {
      color: var(--muted);

      line-height: 1.6;

      margin-bottom: 17px;
    }

    .details {
      display: flex;

      flex-direction: column;

      gap: 8px;

      color: var(--muted);

      font-size: 14px;

      margin-bottom: 20px;
    }

    .card-buttons {
      display: flex;

      gap: 10px;
    }

    .apply-btn {
      flex: 1;

      background: var(--primary);

      color: white;

      padding: 11px;

      border-radius: 8px;

      font-weight: bold;
    }

    .apply-btn:hover {
      background: var(--primary-dark);
    }

    .save-btn {
      background: var(--bg);

      color: var(--text);

      padding: 11px 15px;

      border-radius: 8px;

      border: 1px solid var(--border);

      font-size: 18px;
    }

    .save-btn.saved {
      color: #f59e0b;
    }

    /* =========================================
       ELIGIBILITY CHECKER
    ========================================= */

    .checker {
      max-width: 700px;

      margin: auto;

      background: var(--card);

      padding: 35px;

      border-radius: 18px;

      border: 1px solid var(--border);

      box-shadow: var(--shadow);
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;

      margin-bottom: 8px;

      font-weight: bold;
    }

    .form-group input,
    .form-group select {
      width: 100%;

      padding: 13px;

      border: 1px solid var(--border);

      border-radius: 8px;

      background: var(--bg);

      color: var(--text);

      outline: none;
    }

    .check-btn {
      width: 100%;

      background: var(--primary);

      color: white;

      padding: 14px;

      border-radius: 9px;

      font-weight: bold;

      font-size: 16px;
    }

    #result {
      margin-top: 20px;

      padding: 15px;

      border-radius: 10px;

      display: none;

      line-height: 1.6;
    }

    .success {
      background: #dcfce7;
      color: #166534;
    }

    .warning {
      background: #fef3c7;
      color: #92400e;
    }

    /* =========================================
       DASHBOARD
    ========================================= */

    .dashboard {
      display: grid;

      grid-template-columns: repeat(3, 1fr);

      gap: 20px;
    }

    .dashboard-card {
      background: var(--card);

      border: 1px solid var(--border);

      padding: 25px;

      border-radius: 15px;
    }

    .dashboard-card h3 {
      margin-bottom: 10px;
    }

    .big-number {
      font-size: 35px;

      color: var(--primary);

      font-weight: bold;

      margin-bottom: 5px;
    }

    .dashboard-card p {
      color: var(--muted);
    }

    /* =========================================
       DEVELOPER SECTION
    ========================================= */

    .developer-section {
      background: var(--bg);
    }

    .developer-card {
      max-width: 1050px;

      margin: auto;

      background: var(--card);

      border: 1px solid var(--border);

      border-radius: 25px;

      padding: 45px;

      display: flex;

      gap: 40px;

      align-items: flex-start;

      box-shadow: var(--shadow);
    }

    .developer-avatar {
      min-width: 135px;

      height: 135px;

      border-radius: 50%;

      background:
        linear-gradient(
          135deg,
          var(--primary),
          var(--secondary)
        );

      color: white;

      display: flex;

      align-items: center;

      justify-content: center;

      font-size: 42px;

      font-weight: bold;

      box-shadow: 0 10px 25px rgba(37, 99, 235, 0.3);
    }

    .developer-info {
      flex: 1;
    }

    .developer-info h2 {
      font-size: 32px;

      margin-bottom: 5px;
    }

    .developer-role {
      color: var(--primary) !important;

      font-weight: bold;

      margin-bottom: 18px;
    }

    .developer-description {
      color: var(--muted);

      line-height: 1.8;

      margin-bottom: 20px;
    }

    .contact-grid {
      display: grid;

      grid-template-columns: repeat(2, 1fr);

      gap: 14px;

      margin-top: 25px;
    }

    .contact-grid a {
      text-decoration: none;

      color: var(--text);

      background: var(--bg);

      border: 1px solid var(--border);

      padding: 15px;

      border-radius: 10px;

      transition: 0.3s;
    }

    .contact-grid a:hover {
      border-color: var(--primary);

      transform: translateY(-2px);
    }

    .contact-grid span {
      color: var(--muted);

      font-size: 13px;
    }

    .portfolio-btn {
      display: inline-block;

      margin-top: 25px;

      padding: 13px 22px;

      background: var(--primary);

      color: white;

      text-decoration: none;

      border-radius: 9px;

      font-weight: bold;

      transition: 0.3s;
    }

    .portfolio-btn:hover {
      background: var(--secondary);

      transform: translateY(-2px);
    }

    /* =========================================
       FOOTER
    ========================================= */

    footer {
      background: #0f172a;

      color: white;

      padding: 50px 7%;
    }

    .footer-content {
      max-width: 1100px;

      margin: auto;

      display: grid;

      grid-template-columns: 1fr 1fr;

      gap: 50px;
    }

    footer h2 {
      margin-bottom: 10px;
    }

    footer h2 span {
      color: #8b5cf6;
    }

    footer h3 {
      margin-bottom: 10px;
    }

    footer p {
      color: #94a3b8;

      margin-top: 8px;

      line-height: 1.6;
    }

    .footer-links {
      display: flex;

      flex-wrap: wrap;

      gap: 12px;

      margin-top: 15px;
    }

    .footer-links a {
      text-decoration: none;

      color: #cbd5e1;

      padding: 7px 10px;

      border-radius: 7px;

      background: rgba(255, 255, 255, 0.05);
    }

    .footer-links a:hover {
      color: white;

      background: var(--primary);
    }

    .copyright {
      max-width: 1100px;

      margin: 35px auto 0;

      padding-top: 25px;

      border-top: 1px solid #334155;

      text-align: center;
    }

    /* =========================================
       TOAST
    ========================================= */

    .toast {
      position: fixed;

      right: 25px;

      bottom: 25px;

      background: #111827;

      color: white;

      padding: 15px 20px;

      border-radius: 10px;

      transform: translateY(100px);

      opacity: 0;

      transition: 0.3s;

      z-index: 2000;
    }

    .toast.show {
      transform: translateY(0);

      opacity: 1;
    }

    /* =========================================
       MOBILE
    ========================================= */

    @media (max-width: 1000px) {

      .categories {
        grid-template-columns: repeat(2, 1fr);
      }

      .opportunities {
        grid-template-columns: repeat(2, 1fr);
      }

      .dashboard {
        grid-template-columns: 1fr;
      }

    }

    @media (max-width: 750px) {

      nav {
        padding: 0 5%;
      }

      .nav-links {
        display: none;

        position: absolute;

        top: 72px;

        left: 0;

        width: 100%;

        background: var(--card);

        flex-direction: column;

        padding: 20px 5%;

        border-bottom: 1px solid var(--border);
      }

      .nav-links.active {
        display: flex;
      }

      .menu-btn {
        display: block;
      }

      .hero {
        flex-direction: column;

        text-align: center;

        padding: 65px 5%;
      }

      .hero h1 {
        font-size: 40px;
      }

      .hero-buttons {
        justify-content: center;
      }

      .hero-card {
        width: 100%;
        max-width: 400px;
      }

      section {
        padding: 55px 5%;
      }

      .developer-card {
        flex-direction: column;

        text-align: center;

        padding: 30px;
      }

      .developer-avatar {
        margin: auto;
      }

    }

    @media (max-width: 550px) {

      .categories,
      .opportunities {
        grid-template-columns: 1fr;
      }

      .search-box {
        flex-direction: column;
      }

      .search-box select {
        width: 100%;
      }

      .contact-grid {
        grid-template-columns: 1fr;

        text-align: left;
      }

      .footer-content {
        grid-template-columns: 1fr;

        text-align: center;
      }

      .footer-links {
        justify-content: center;
      }

      .section-title h2 {
        font-size: 29px;
      }

    }

  </style>
</head>


<body>

  <!-- =========================================
       NAVIGATION
  ========================================= -->

  <nav>

    <a class="brand-logo" href="#home" aria-label="OpportunityHub home">
      <svg class="brand-icon" viewBox="0 0 100 100" aria-hidden="true">
        <path
          class="logo-line"
          d="M50 18
             C40 11 27 15 23 26
             C12 29 7 42 13 52
             C8 63 15 76 27 79
             C33 90 47 93 57 86
             C68 90 80 82 81 70
             C91 63 91 48 82 40
             C82 28 70 20 59 23
             C56 16 53 15 50 18Z"/>
        <path class="logo-line" d="M50 18 L50 50 L57 86"/>
        <path class="logo-line" d="M23 26 L50 50 L82 40"/>
        <path class="logo-line" d="M13 52 L50 50 L81 70"/>
        <path class="logo-line" d="M27 79 L50 50"/>
      </svg>

      <div class="logo">
        Opportunity<span>Hub</span>
      </div>
    </a>

    <ul class="nav-links" id="navLinks">

      <li>
        <a href="#home">Home</a>
      </li>

      <li>
        <a href="#opportunities">Opportunities</a>
      </li>

      <li>
        <a href="#checker">Eligibility</a>
      </li>

      <li>
        <a href="#dashboard">Dashboard</a>
      </li>

      <li>
        <a href="#contact">Contact</a>
      </li>

    </ul>

    <div class="nav-actions">

      <button
        class="theme-btn"
        onclick="toggleTheme()"
        id="themeButton"
        aria-label="Toggle dark mode">
        🌙
      </button>

      <button
        class="menu-btn"
        onclick="toggleMenu()"
        aria-label="Open menu">
        ☰
      </button>

    </div>

  </nav>


  <!-- =========================================
       HERO
  ========================================= -->

  <header class="hero" id="home">

    <div class="hero-content">

      <h1>
        Find Opportunities.
        Build Your Future.
      </h1>

      <p>
        OpportunityHub helps students discover
        scholarships, internships, jobs and free
        learning opportunities in one simple platform.
      </p>

      <div class="hero-buttons">

        <button
          class="primary-btn"
          onclick="scrollToSection('opportunities')">
          Explore Opportunities
        </button>

        <button
          class="secondary-btn"
          onclick="scrollToSection('checker')">
          Check Eligibility
        </button>

      </div>

    </div>


    <div class="hero-card">

      <h3>📊 Platform Overview</h3>

      <div class="stat">
        <span>Opportunities</span>
        <strong id="heroTotal">12+</strong>
      </div>

      <div class="stat">
        <span>Scholarships</span>
        <strong id="heroScholarships">3</strong>
      </div>

      <div class="stat">
        <span>Internships</span>
        <strong id="heroInternships">4</strong>
      </div>

      <div class="stat">
        <span>Courses</span>
        <strong id="heroCourses">3</strong>
      </div>

      <div class="stat">
        <span>Jobs</span>
        <strong id="heroJobs">2</strong>
      </div>

    </div>

  </header>


  <!-- =========================================
       CATEGORIES
  ========================================= -->

  <section>

    <div class="section-title">

      <h2>Explore Categories</h2>

      <p>
        Find opportunities that match your goals.
      </p>

    </div>


    <div class="categories">

      <div
        class="category"
        onclick="filterCategory('Scholarship')">

        <div class="category-icon">
          🎓
        </div>

        <h3>Scholarships</h3>

        <p>
          Financial support for your education.
        </p>

      </div>


      <div
        class="category"
        onclick="filterCategory('Internship')">

        <div class="category-icon">
          💼
        </div>

        <h3>Internships</h3>

        <p>
          Gain practical work experience.
        </p>

      </div>


      <div
        class="category"
        onclick="filterCategory('Course')">

        <div class="category-icon">
          📚
        </div>

        <h3>Courses</h3>

        <p>
          Learn valuable new skills.
        </p>

      </div>


      <div
        class="category"
        onclick="filterCategory('Job')">

        <div class="category-icon">
          🚀
        </div>

        <h3>Jobs</h3>

        <p>
          Start building your career.
        </p>

      </div>

    </div>

  </section>


  <!-- =========================================
       OPPORTUNITIES
  ========================================= -->

  <section id="opportunities">

    <div class="section-title">

      <h2>Latest Opportunities</h2>

      <p>
        Search and discover opportunities.
      </p>

    </div>


    <div class="search-box">

      <input
        type="text"
        id="searchInput"
        placeholder="Search scholarships, jobs, courses..."
        onkeyup="filterOpportunities()"
      >

      <select
        id="categoryFilter"
        onchange="filterOpportunities()">

        <option value="All">
          All Categories
        </option>

        <option value="Scholarship">
          Scholarship
        </option>

        <option value="Internship">
          Internship
        </option>

        <option value="Course">
          Course
        </option>

        <option value="Job">
          Job
        </option>

      </select>

    </div>


    <div
      class="opportunities"
      id="opportunityList">
    </div>

  </section>


  <!-- =========================================
       ELIGIBILITY CHECKER
  ========================================= -->

  <section id="checker">

    <div class="section-title">

      <h2>Eligibility Checker</h2>

      <p>
        Check basic eligibility before exploring an opportunity.
      </p>

    </div>


    <div class="checker">

      <div class="form-group">

        <label for="age">
          Your Age
        </label>

        <input
          type="number"
          id="age"
          min="1"
          max="100"
          placeholder="Enter your age">

      </div>


      <div class="form-group">

        <label for="education">
          Education Level
        </label>

        <select id="education">

          <option value="">
            Select education level
          </option>

          <option value="secondary">
            Secondary School
          </option>

          <option value="undergraduate">
            Undergraduate
          </option>

          <option value="graduate">
            Graduate
          </option>

        </select>

      </div>


      <div class="form-group">

        <label for="opportunityType">
          Opportunity Type
        </label>

        <select id="opportunityType">

          <option value="">
            Select opportunity
          </option>

          <option value="scholarship">
            Scholarship
          </option>

          <option value="internship">
            Internship
          </option>

          <option value="course">
            Course
          </option>

          <option value="job">
            Job
          </option>

        </select>

      </div>


      <button
        class="check-btn"
        onclick="checkEligibility()">

        Check Eligibility

      </button>


      <div id="result"></div>

    </div>

  </section>


  <!-- =========================================
       DASHBOARD
  ========================================= -->

  <section id="dashboard">

